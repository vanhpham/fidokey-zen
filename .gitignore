build*/
*__pycache__*
legacy/
.DS_Store

# ESP-IDF local build/config artifacts (regenerated by idf.py)
managed_components/
sdkconfig
sdkconfig.old
dependencies.lock

# Fetched build-time dependencies (see pico-keys-sdk/cmake/deps.cmake --
# these are cloned on demand by CMake, never committed)
pico-keys-sdk/third-party/

# --- Personal secrets: never commit these ---
# Vault master-key recovery envelopes, exported passkey blobs, and backup
# bundles all contain material tied to your real credentials/device.
tools/kvault_envelope*.json
tools/*.pkv1
tools/pico-fido-backup-*.zip
tools/*.der
tools/*.pem

*.orig-ca.bak
